# =====================================================
#  Ashen Crown — .gitignore
#  Coloca este archivo en la raíz del proyecto:
#  Proyecto_AshenCrown/.gitignore
# =====================================================

# ── Backend Java / Maven ───────────────────────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/**/*.class
backend/**/*.jar
backend/**/*.war
*.iml
.idea/
*.ipr
*.iws

# ── Contraseñas y configuración sensible ───────────
# IMPORTANTE: nunca subas application.properties con tu contraseña real
# Renómbralo a application.properties.example antes de subir
backend/src/main/resources/application.properties

# ── Frontend Node.js ───────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local

# ── Variables de entorno ───────────────────────────
.env
.env.local
.env.development
.env.production
**/.env

# ── Logs ───────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Assets binarios pesados (NO subir a GitHub) ───
# Movies/ y characters/ SÍ se incluyen — son los usados en el juego (cada uno < 100 MB).
# Music, Backgrounds, etc. son demasiado grandes para GitHub.
frontend/src/assets/Music/
frontend/src/assets/Sound Effects/
frontend/src/assets/Backgrounds/
frontend/src/assets/Accessories/
frontend/src/assets/App Icons/
frontend/src/assets/Character Art + Sprites/
frontend/src/assets/Voices [English]/
frontend/src/assets/Voices [Japanese]/
frontend/src/assets/Weapon Sprites/
frontend/src/assets/UI/
# Mapas: se excluye toda Maps/ y se fuerza git add solo en los 14 mapas de niveles
frontend/src/assets/Maps/

# ── Sistema operativo ──────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── VSCode ─────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
# Mantener .vscode/tasks.json si lo usas para compartir configuración

# Copia este archivo como .env.local para desarrollo local
# En Vercel, agrega estas variables en Project Settings > Environment Variables

# URL base del backend (sin slash al final)
VITE_API_URL=http://localhost:8080

# API Key de Google Gemini — obtenerla en https://aistudio.google.com
VITE_GEMINI_API_KEY=tu_api_key_aqui
